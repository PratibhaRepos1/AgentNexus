---
import Layout from "../layouts/Layout.astro";
import BentoCard from "../components/BentoCard.astro";
import CTASection from "../components/CTASection.astro";

const steps = [
  {
    step: "01",
    title: "Add your knowledge",
    description: "Upload documents, import a webpage, or write FAQs — takes minutes, not days.",
  },
  {
    step: "02",
    title: "Paste one script tag",
    description: "Embed the widget on your site. It matches your brand automatically.",
  },
  {
    step: "03",
    title: "Let it work 24/7",
    description: "Customers get instant answers. You get qualified leads in your inbox.",
  },
];

const plans = [
  { name: "Free", price: "₹0", cta: "Start Free" },
  { name: "Basic", price: "₹1,999/mo", cta: "Choose Basic" },
  { name: "Business", price: "₹3,999/mo", cta: "Choose Business", featured: true },
  { name: "Growth", price: "₹7,999/mo", cta: "Choose Growth" },
];
---

<Layout
  title="AI Chat Widget for Small Businesses"
  description="ChatBiz gives your business a branded AI chat widget that answers customer questions from your own FAQs, documents, and catalog — day or night. Free plan available."
  path="/"
>
  <!-- Hero -->
  <section class="overflow-hidden bg-white">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 pt-16 pb-20 lg:grid-cols-2 lg:pt-24 lg:pb-28">
      <!-- Left: copy -->
      <div>
        <p class="font-display brand-gradient-text text-3xl font-extrabold leading-tight sm:text-4xl">
          Never Miss a Customer
        </p>
        <h1 class="font-display mt-1 text-4xl font-extrabold leading-tight text-slate-900 sm:text-5xl">
          AI chat widget for your business website
        </h1>
        <p class="mt-6 max-w-lg text-lg text-slate-500">
          Create an AI chatbot trained on your own FAQs, documents, and catalog — add it to your
          site in one line, and let it answer customers, capture leads, and drive sales, 24/7.
        </p>

        <div class="mt-8">
          <a
            href="/demo"
            class="brand-gradient inline-block rounded-full px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-violet-200 transition-transform hover:scale-105"
          >
            Book a Free Demo
          </a>
          <p class="mt-3 text-sm text-slate-400">No credit card needed</p>
        </div>
      </div>

      <!-- Right: chat widget mockup -->
      <div class="relative mx-auto w-full max-w-md">
        <div class="absolute inset-0 translate-x-6 translate-y-6 rotate-3 rounded-3xl bg-blue-100"></div>
        <div class="absolute inset-0 translate-x-3 translate-y-3 -rotate-1 rounded-3xl bg-blue-100"></div>

        <div class="relative overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-xl shadow-indigo-100">
          <div class="flex items-center gap-3 border-b border-slate-100 px-5 py-4">
            <div class="brand-gradient grid h-9 w-9 place-items-center rounded-full text-white">🤖</div>
            <div>
              <p class="font-display text-sm font-semibold text-slate-900">ChatBiz Assistant</p>
              <p class="flex items-center gap-1 text-xs text-emerald-500">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> Online
              </p>
            </div>
          </div>

          <div class="space-y-3 px-5 py-6">
            <div class="max-w-[75%] rounded-2xl rounded-tl-sm bg-slate-100 px-4 py-2.5 text-sm text-slate-700">
              Hi! Do you deliver outside the city?
            </div>
            <div class="ml-auto max-w-[75%] rounded-2xl rounded-tr-sm bg-violet-600 px-4 py-2.5 text-sm text-white">
              Yes — we deliver statewide, usually within 2 business days 🚚
            </div>
            <div class="max-w-[75%] rounded-2xl rounded-tl-sm bg-slate-100 px-4 py-2.5 text-sm text-slate-700">
              Perfect, can I get a callback?
            </div>
          </div>

          <div class="flex items-center gap-2 border-t border-slate-100 px-5 py-3">
            <div class="flex-1 rounded-full bg-slate-100 px-4 py-2 text-sm text-slate-400">Type a message…</div>
            <div class="brand-gradient grid h-8 w-8 place-items-center rounded-full text-white">➤</div>
          </div>
        </div>

        <div class="brand-gradient absolute -bottom-5 -right-5 grid h-14 w-14 place-items-center rounded-full text-2xl text-white shadow-lg shadow-violet-200">
          💬
          <span class="absolute -top-1 -right-1 grid h-5 w-5 place-items-center rounded-full bg-amber-400 text-[10px] font-bold text-white">1</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Social proof strip -->
  <section class="border-b border-slate-100 bg-white py-6">
    <p class="text-center text-sm font-medium text-slate-400">
      Built for retail shops, clinics, restaurants, real estate agents &amp; service businesses
    </p>
  </section>

  <!-- Feature highlights -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold text-slate-900 sm:text-4xl">
        Everything you need, <span class="brand-gradient-text">nothing you don't</span>
      </h2>
      <p class="mt-4 text-slate-500">
        A chat widget that's actually grounded in your business — plus the dashboard to run it.
      </p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- One-line embed -->
      <BentoCard title="One-line embed" description="Drop a single script tag on your site. No app to install, no iframe headaches.">
        <div class="w-full">
          <div class="rounded-xl border border-slate-100 bg-white p-3">
            <div class="mb-2 flex gap-1.5">
              <span class="h-2 w-2 rounded-full bg-slate-300"></span>
              <span class="h-2 w-2 rounded-full bg-slate-300"></span>
              <span class="h-2 w-2 rounded-full bg-slate-300"></span>
            </div>
            <div class="rounded-lg bg-slate-900 px-3 py-2 font-mono text-[11px] leading-relaxed text-blue-300">
              &lt;script src="chatbiz.js"&gt;<br />&lt;/script&gt;
            </div>
          </div>
          <div class="brand-gradient mx-auto -mt-4 grid h-9 w-9 place-items-center rounded-full text-base text-white shadow-md">
            💬
          </div>
        </div>
      </BentoCard>

      <!-- Actually knows your business -->
      <BentoCard title="Actually knows your business" description="Answers from your real FAQs, documents, and product catalog — not generic web knowledge.">
        <div class="w-full">
          <div class="flex flex-wrap justify-center gap-1.5">
            <span class="rounded-full bg-violet-50 px-2.5 py-1 text-[11px] font-medium text-violet-600">FAQs</span>
            <span class="rounded-full bg-blue-50 px-2.5 py-1 text-[11px] font-medium text-blue-600">Documents</span>
            <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-[11px] font-medium text-indigo-600">Catalog</span>
          </div>
          <div class="mx-auto mt-2 h-5 w-px bg-slate-200"></div>
          <div class="mx-auto mt-1 max-w-[85%] rounded-xl rounded-tl-sm bg-slate-100 px-3 py-2 text-[11px] text-slate-600">
            Grounded answer <span class="text-emerald-500">✓</span>
          </div>
        </div>
      </BentoCard>

      <!-- Upload almost anything -->
      <BentoCard title="Upload almost anything" description="PDF, Word, Excel, CSV, or just paste a URL from your existing website.">
        <div class="grid grid-cols-3 gap-2.5">
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-red-50 text-[11px] font-bold text-red-500">PDF</div>
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-blue-50 text-[11px] font-bold text-blue-500">DOC</div>
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-emerald-50 text-[11px] font-bold text-emerald-500">XLS</div>
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-amber-50 text-[11px] font-bold text-amber-500">CSV</div>
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-violet-50 text-[11px] font-bold text-violet-500">URL</div>
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-slate-100 text-lg text-slate-400">+</div>
        </div>
      </BentoCard>

      <!-- Never misses a lead -->
      <BentoCard title="Never misses a lead" description="A contact form appears automatically the moment the bot senses buying intent.">
        <div class="w-full rounded-xl border border-slate-100 bg-white p-3">
          <div class="mb-2 flex items-center justify-between">
            <span class="text-[11px] font-semibold text-slate-500">Contact details</span>
            <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-600">New lead</span>
          </div>
          <div class="mb-1.5 h-2.5 w-full rounded-full bg-slate-200"></div>
          <div class="mb-2.5 h-2.5 w-3/4 rounded-full bg-slate-200"></div>
          <div class="brand-gradient rounded-full py-1.5 text-center text-[11px] font-semibold text-white">Contact Me</div>
        </div>
      </BentoCard>

      <!-- On brand, every time -->
      <BentoCard title="On brand, every time" description="Your colors, your bot name, your tone of voice — friendly, formal, or playful.">
        <div class="w-full text-center">
          <div class="flex justify-center gap-2">
            <span class="h-6 w-6 rounded-full bg-violet-500 ring-2 ring-violet-200 ring-offset-2"></span>
            <span class="h-6 w-6 rounded-full bg-blue-500"></span>
            <span class="h-6 w-6 rounded-full bg-emerald-500"></span>
            <span class="h-6 w-6 rounded-full bg-amber-500"></span>
          </div>
          <div class="mx-auto mt-3 w-32 rounded-lg border border-slate-200 px-3 py-1.5 text-left text-[11px] text-slate-500">
            Bot name: <span class="font-semibold text-slate-700">Aria</span>
          </div>
        </div>
      </BentoCard>

      <!-- Multi-tenant safety -->
      <BentoCard title="Built for multi-tenant safety" description="Every business's data is fully isolated — no cross-tenant leaks, ever.">
        <div class="text-center">
          <div class="brand-gradient mx-auto grid h-14 w-14 place-items-center rounded-2xl text-2xl text-white">🔒</div>
          <div class="mt-3 flex items-center justify-center gap-2 text-[11px] font-medium">
            <span class="rounded-lg bg-slate-100 px-2 py-1 text-slate-500">Business A</span>
            <span class="text-slate-300">✕</span>
            <span class="rounded-lg bg-slate-100 px-2 py-1 text-slate-500">Business B</span>
          </div>
        </div>
      </BentoCard>
    </div>
    <div class="mt-10 text-center">
      <a href="/features" class="text-sm font-semibold text-violet-600 hover:text-violet-700">
        See all features &rarr;
      </a>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="font-display text-center text-3xl font-bold text-slate-900 sm:text-4xl">
        Live in three steps
      </h2>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {
          steps.map((s) => (
            <div class="relative rounded-2xl bg-white p-8 shadow-sm shadow-slate-100">
              <span class="font-display brand-gradient-text text-4xl font-extrabold">{s.step}</span>
              <h3 class="font-display mt-4 text-lg font-semibold text-slate-900">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{s.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold text-slate-900 sm:text-4xl">Simple, honest pricing</h2>
      <p class="mt-4 text-slate-500">Start free. Upgrade only when you're getting real value.</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        plans.map((plan) => (
          <div
            class:list={[
              "rounded-2xl border p-6 text-center",
              plan.featured
                ? "brand-gradient border-transparent text-white shadow-xl shadow-violet-200"
                : "border-slate-200 bg-white",
            ]}
          >
            {plan.featured && (
              <span class="inline-block rounded-full bg-white/20 px-3 py-1 text-xs font-semibold">
                Most Popular
              </span>
            )}
            <h3 class:list={["font-display mt-3 text-lg font-semibold", plan.featured ? "text-white" : "text-slate-900"]}>
              {plan.name}
            </h3>
            <p class:list={["font-display mt-2 text-2xl font-bold", plan.featured ? "text-white" : "text-slate-900"]}>
              {plan.price}
            </p>
            <a
              href="/pricing"
              class:list={[
                "mt-6 inline-block w-full rounded-full px-4 py-2.5 text-sm font-semibold transition-transform hover:scale-105",
                plan.featured ? "bg-white text-violet-700" : "bg-indigo-50 text-violet-700",
              ]}
            >
              {plan.cta}
            </a>
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-center text-sm text-slate-500">
      Full plan comparison and billing details on the <a href="/pricing" class="font-semibold text-violet-600 hover:text-violet-700">pricing page</a>.
    </p>
  </section>

  <CTASection
    heading="Ready to stop losing customers to slow replies?"
    subheading="Set up your AI chat widget in minutes — free plan, no credit card needed."
  />
</Layout>
