---
import Layout from "../layouts/Layout.astro";
import BentoCard from "../components/BentoCard.astro";
import CTASection from "../components/CTASection.astro";
import Price from "../components/Price.astro";
import dashboardVideo from "../assets/chatcraft dashbaord analysis.mp4";
import en from "../assets/i18n/en/home.json";
import enCommon from "../assets/i18n/en/common.json";

const steps = en.HOW_IT_WORKS.STEPS;
const plans = en.PRICING_TEASER.PLANS;
---

<Layout
  title={en.SEO.TITLE}
  description={en.SEO.DESCRIPTION}
  path="/"
  page="home"
  titleKey="SEO.TITLE"
  descriptionKey="SEO.DESCRIPTION"
>
  <!-- Hero -->
  <section class="overflow-hidden bg-white">
    <div class="mx-auto grid max-w-[1440px] items-center gap-12 px-6 pt-16 pb-20 lg:grid-cols-2 lg:pt-24 lg:pb-28">
      <!-- Left: copy -->
      <div>
        <p class="font-display brand-gradient-text text-3xl font-extrabold leading-tight sm:text-4xl" data-i18n="HERO.EYEBROW">
          {en.HERO.EYEBROW}
        </p>
        <h1 class="font-display mt-1 text-4xl font-extrabold leading-tight text-slate-900 sm:text-5xl" data-i18n="HERO.TITLE">
          {en.HERO.TITLE}
        </h1>
        <p class="mt-6 max-w-lg text-lg text-slate-500" data-i18n="HERO.SUBTITLE">
          {en.HERO.SUBTITLE}
        </p>

        <div class="mt-8">
          <a
            href="/demo"
            data-i18n="BUTTONS.BOOK_DEMO"
            class="brand-gradient inline-block rounded-full px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-violet-200 transition-transform hover:scale-105"
          >
            {enCommon.BUTTONS.BOOK_DEMO}
          </a>
          <p class="mt-3 text-sm text-slate-400" data-i18n="MESSAGES.NO_CREDIT_CARD">{enCommon.MESSAGES.NO_CREDIT_CARD}</p>
        </div>
      </div>

      <!-- Right: chat widget screenshot -->
      <div class="relative mx-auto w-full max-w-xs">
        <div class="absolute inset-0 translate-x-6 translate-y-6 rotate-3 rounded-3xl bg-blue-100"></div>
        <div class="absolute inset-0 translate-x-3 translate-y-3 -rotate-1 rounded-3xl bg-blue-100"></div>

        <img
          src="/images/hero-widget-screenshot.png"
          alt={en.HERO.IMAGE_ALT}
          data-i18n-attr="alt:HERO.IMAGE_ALT"
          class="relative w-full rounded-3xl border border-slate-100 shadow-xl shadow-indigo-100"
        />

        <div class="absolute -bottom-5 -right-5">
          <img src="/images/hero-chat-bubble.png" alt="" aria-hidden="true" class="h-14 w-14 rounded-full shadow-lg shadow-violet-200" />
          <span class="absolute -top-1 -right-1 grid h-5 w-5 place-items-center rounded-full bg-amber-400 text-[10px] font-bold text-white">1</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Social proof strip -->
  <section class="border-b border-slate-100 bg-white py-6">
    <p class="text-center text-sm font-medium text-slate-400" data-i18n="SOCIAL_PROOF.TEXT">
      {en.SOCIAL_PROOF.TEXT}
    </p>
  </section>

  <!-- Feature highlights -->
  <section class="mx-auto max-w-[1440px] px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold text-slate-900 sm:text-4xl">
        <span data-i18n="FEATURES_SECTION.HEADING_PLAIN">{en.FEATURES_SECTION.HEADING_PLAIN}</span>{" "}
        <span class="brand-gradient-text" data-i18n="FEATURES_SECTION.HEADING_ACCENT">{en.FEATURES_SECTION.HEADING_ACCENT}</span>
      </h2>
      <p class="mt-4 text-slate-500" data-i18n="FEATURES_SECTION.SUBHEADING">
        {en.FEATURES_SECTION.SUBHEADING}
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-4xl">
      <video
        id="dashboard-demo-video"
        class="aspect-[1908/988] w-full rounded-2xl border border-slate-100 object-cover shadow-xl shadow-indigo-100"
        src={dashboardVideo}
        autoplay
        loop
        muted
        playsinline
        controls
        aria-label={en.FEATURES_SECTION.VIDEO_ALT}
        data-i18n-attr="aria-label:FEATURES_SECTION.VIDEO_ALT"
      />
    </div>
    <script>
      const dashboardVideoEl = document.getElementById("dashboard-demo-video") as HTMLVideoElement | null;
      if (dashboardVideoEl && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        dashboardVideoEl.removeAttribute("autoplay");
        dashboardVideoEl.removeAttribute("loop");
        dashboardVideoEl.pause();
      }
    </script>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <!-- One-line embed -->
      <BentoCard
        title={en.BENTO.ONE_LINE_EMBED.TITLE}
        description={en.BENTO.ONE_LINE_EMBED.DESCRIPTION}
        titleKey="BENTO.ONE_LINE_EMBED.TITLE"
        descriptionKey="BENTO.ONE_LINE_EMBED.DESCRIPTION"
      >
        <div class="w-full">
          <div class="rounded-xl border border-slate-100 bg-white p-3">
            <div class="mb-2 flex gap-1.5">
              <span class="h-2 w-2 rounded-full bg-slate-300"></span>
              <span class="h-2 w-2 rounded-full bg-slate-300"></span>
              <span class="h-2 w-2 rounded-full bg-slate-300"></span>
            </div>
            <div class="rounded-lg bg-slate-900 px-3 py-2 font-mono text-[11px] leading-relaxed text-blue-300">
              &lt;script src="chatcraft.js"&gt;<br />&lt;/script&gt;
            </div>
          </div>
          <div class="brand-gradient mx-auto -mt-4 grid h-9 w-9 place-items-center rounded-full text-base text-white shadow-md">
            💬
          </div>
        </div>
      </BentoCard>

      <!-- Actually knows your business -->
      <BentoCard
        title={en.BENTO.KNOWS_YOUR_BUSINESS.TITLE}
        description={en.BENTO.KNOWS_YOUR_BUSINESS.DESCRIPTION}
        titleKey="BENTO.KNOWS_YOUR_BUSINESS.TITLE"
        descriptionKey="BENTO.KNOWS_YOUR_BUSINESS.DESCRIPTION"
      >
        <div class="w-full">
          <div class="flex flex-wrap justify-center gap-1.5">
            <span class="rounded-full bg-violet-50 px-2.5 py-1 text-[11px] font-medium text-violet-600" data-i18n="BENTO.KNOWS_YOUR_BUSINESS.TAG_FAQS">
              {en.BENTO.KNOWS_YOUR_BUSINESS.TAG_FAQS}
            </span>
            <span class="rounded-full bg-blue-50 px-2.5 py-1 text-[11px] font-medium text-blue-600" data-i18n="BENTO.KNOWS_YOUR_BUSINESS.TAG_DOCUMENTS">
              {en.BENTO.KNOWS_YOUR_BUSINESS.TAG_DOCUMENTS}
            </span>
            <span class="rounded-full bg-indigo-50 px-2.5 py-1 text-[11px] font-medium text-indigo-600" data-i18n="BENTO.KNOWS_YOUR_BUSINESS.TAG_CATALOG">
              {en.BENTO.KNOWS_YOUR_BUSINESS.TAG_CATALOG}
            </span>
          </div>
          <div class="mx-auto mt-2 h-5 w-px bg-slate-200"></div>
          <div class="mx-auto mt-1 max-w-[85%] rounded-xl rounded-tl-sm bg-slate-100 px-3 py-2 text-[11px] text-slate-600">
            <span data-i18n="BENTO.KNOWS_YOUR_BUSINESS.GROUNDED_ANSWER">{en.BENTO.KNOWS_YOUR_BUSINESS.GROUNDED_ANSWER}</span> <span class="text-emerald-500">✓</span>
          </div>
        </div>
      </BentoCard>

      <!-- Upload almost anything -->
      <BentoCard
        title={en.BENTO.UPLOAD_ANYTHING.TITLE}
        description={en.BENTO.UPLOAD_ANYTHING.DESCRIPTION}
        titleKey="BENTO.UPLOAD_ANYTHING.TITLE"
        descriptionKey="BENTO.UPLOAD_ANYTHING.DESCRIPTION"
      >
        <div class="grid grid-cols-3 gap-2.5">
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-red-50 text-[11px] font-bold text-red-500">PDF</div>
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-blue-50 text-[11px] font-bold text-blue-500">DOC</div>
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-emerald-50 text-[11px] font-bold text-emerald-500">XLS</div>
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-amber-50 text-[11px] font-bold text-amber-500">CSV</div>
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-violet-50 text-[11px] font-bold text-violet-500">URL</div>
          <div class="grid h-12 w-12 place-items-center rounded-xl bg-slate-100 text-lg text-slate-400">+</div>
        </div>
      </BentoCard>

      <!-- Never misses a lead -->
      <BentoCard
        title={en.BENTO.NEVER_MISSES_LEAD.TITLE}
        description={en.BENTO.NEVER_MISSES_LEAD.DESCRIPTION}
        titleKey="BENTO.NEVER_MISSES_LEAD.TITLE"
        descriptionKey="BENTO.NEVER_MISSES_LEAD.DESCRIPTION"
      >
        <div class="w-full rounded-xl border border-slate-100 bg-white p-3">
          <div class="mb-2 flex items-center justify-between">
            <span class="text-[11px] font-semibold text-slate-500" data-i18n="BENTO.NEVER_MISSES_LEAD.CONTACT_DETAILS">
              {en.BENTO.NEVER_MISSES_LEAD.CONTACT_DETAILS}
            </span>
            <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[10px] font-semibold text-emerald-600" data-i18n="BENTO.NEVER_MISSES_LEAD.NEW_LEAD">
              {en.BENTO.NEVER_MISSES_LEAD.NEW_LEAD}
            </span>
          </div>
          <div class="mb-1.5 h-2.5 w-full rounded-full bg-slate-200"></div>
          <div class="mb-2.5 h-2.5 w-3/4 rounded-full bg-slate-200"></div>
          <div class="brand-gradient rounded-full py-1.5 text-center text-[11px] font-semibold text-white" data-i18n="BENTO.NEVER_MISSES_LEAD.CONTACT_ME">
            {en.BENTO.NEVER_MISSES_LEAD.CONTACT_ME}
          </div>
        </div>
      </BentoCard>

      <!-- On brand, every time -->
      <BentoCard
        title={en.BENTO.ON_BRAND.TITLE}
        description={en.BENTO.ON_BRAND.DESCRIPTION}
        titleKey="BENTO.ON_BRAND.TITLE"
        descriptionKey="BENTO.ON_BRAND.DESCRIPTION"
      >
        <div class="w-full text-center">
          <div class="flex justify-center gap-2">
            <span class="h-6 w-6 rounded-full bg-violet-500 ring-2 ring-violet-200 ring-offset-2"></span>
            <span class="h-6 w-6 rounded-full bg-blue-500"></span>
            <span class="h-6 w-6 rounded-full bg-emerald-500"></span>
            <span class="h-6 w-6 rounded-full bg-amber-500"></span>
          </div>
          <div class="mx-auto mt-3 w-32 rounded-lg border border-slate-300 px-3 py-1.5 text-left text-[11px] text-slate-500">
            <span data-i18n="BENTO.ON_BRAND.BOT_NAME_LABEL">{en.BENTO.ON_BRAND.BOT_NAME_LABEL}</span>{" "}
            <span class="font-semibold text-slate-700" data-i18n="BENTO.ON_BRAND.BOT_NAME_VALUE">{en.BENTO.ON_BRAND.BOT_NAME_VALUE}</span>
          </div>
        </div>
      </BentoCard>

      <!-- Multi-tenant safety -->
      <BentoCard
        title={en.BENTO.MULTI_TENANT.TITLE}
        description={en.BENTO.MULTI_TENANT.DESCRIPTION}
        titleKey="BENTO.MULTI_TENANT.TITLE"
        descriptionKey="BENTO.MULTI_TENANT.DESCRIPTION"
      >
        <div class="text-center">
          <div class="brand-gradient mx-auto grid h-14 w-14 place-items-center rounded-2xl text-2xl text-white">🔒</div>
          <div class="mt-3 flex items-center justify-center gap-2 text-[11px] font-medium">
            <span class="rounded-lg bg-slate-100 px-2 py-1 text-slate-500" data-i18n="BENTO.MULTI_TENANT.BUSINESS_A">
              {en.BENTO.MULTI_TENANT.BUSINESS_A}
            </span>
            <span class="text-slate-300">✕</span>
            <span class="rounded-lg bg-slate-100 px-2 py-1 text-slate-500" data-i18n="BENTO.MULTI_TENANT.BUSINESS_B">
              {en.BENTO.MULTI_TENANT.BUSINESS_B}
            </span>
          </div>
        </div>
      </BentoCard>
    </div>
    <div class="mt-10 text-center">
      <a href="/features" class="text-sm font-semibold text-violet-600 hover:text-violet-700" data-i18n="FEATURES_SECTION.SEE_ALL_LINK">
        {en.FEATURES_SECTION.SEE_ALL_LINK}
      </a>
    </div>
  </section>

  <!-- How it works -->
  <section class="bg-slate-50 py-20">
    <div class="mx-auto max-w-[1440px] px-6">
      <h2 class="font-display text-center text-3xl font-bold text-slate-900 sm:text-4xl" data-i18n="HOW_IT_WORKS.HEADING">
        {en.HOW_IT_WORKS.HEADING}
      </h2>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {
          steps.map((s, i) => (
            <div class="relative rounded-2xl bg-white p-8 shadow-sm shadow-slate-100">
              <span class="font-display brand-gradient-text text-4xl font-extrabold" data-i18n={`HOW_IT_WORKS.STEPS.${i}.STEP`}>
                {s.STEP}
              </span>
              <h3 class="font-display mt-4 text-lg font-semibold text-slate-900" data-i18n={`HOW_IT_WORKS.STEPS.${i}.TITLE`}>
                {s.TITLE}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500" data-i18n={`HOW_IT_WORKS.STEPS.${i}.DESCRIPTION`}>
                {s.DESCRIPTION}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="mx-auto max-w-[1440px] px-6 py-20">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold text-slate-900 sm:text-4xl" data-i18n="PRICING_TEASER.HEADING">
        {en.PRICING_TEASER.HEADING}
      </h2>
      <p class="mt-4 text-slate-500" data-i18n="PRICING_TEASER.SUBHEADING">{en.PRICING_TEASER.SUBHEADING}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        plans.map((plan, i) => (
          <div
            class:list={[
              "rounded-2xl border p-6 text-center",
              plan.FEATURED
                ? "brand-gradient border-transparent text-white shadow-xl shadow-violet-200"
                : "border-slate-300 bg-white",
            ]}
          >
            {plan.FEATURED && (
              <span class="inline-block rounded-full bg-white/20 px-3 py-1 text-xs font-semibold" data-i18n="MESSAGES.MOST_POPULAR">
                {enCommon.MESSAGES.MOST_POPULAR}
              </span>
            )}
            <h3
              class:list={["font-display mt-3 text-lg font-semibold", plan.FEATURED ? "text-white" : "text-slate-900"]}
              data-i18n={`PRICING_TEASER.PLANS.${i}.NAME`}
            >
              {plan.NAME}
            </h3>
            <p
              class:list={["font-display mt-2 text-2xl font-bold", plan.FEATURED ? "text-white" : "text-slate-900"]}
            >
              <Price amount={plan.PRICE_USD} />
              {plan.PERIOD && (
                <span
                  class:list={["ml-0.5 text-sm font-normal", plan.FEATURED ? "text-indigo-100" : "text-slate-400"]}
                  data-i18n={`PRICING_TEASER.PLANS.${i}.PERIOD`}
                >
                  {plan.PERIOD}
                </span>
              )}
            </p>
            <a
              href="/pricing"
              data-i18n={`PRICING_TEASER.PLANS.${i}.CTA`}
              class:list={[
                "mt-6 inline-block w-full rounded-full px-4 py-2.5 text-sm font-semibold transition-transform hover:scale-105",
                plan.FEATURED ? "bg-white text-violet-700" : "bg-indigo-50 text-violet-700",
              ]}
            >
              {plan.CTA}
            </a>
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-center text-sm text-slate-500">
      <span data-i18n="PRICING_TEASER.FOOTER_TEXT_BEFORE_LINK">{en.PRICING_TEASER.FOOTER_TEXT_BEFORE_LINK}</span>{" "}
      <a href="/pricing" class="font-semibold text-violet-600 hover:text-violet-700" data-i18n="PRICING_TEASER.FOOTER_TEXT_LINK">
        {en.PRICING_TEASER.FOOTER_TEXT_LINK}
      </a><span data-i18n="PRICING_TEASER.FOOTER_TEXT_AFTER_LINK">{en.PRICING_TEASER.FOOTER_TEXT_AFTER_LINK}</span>
    </p>
  </section>

  <CTASection
    heading={en.CTA.HEADING}
    subheading={en.CTA.SUBHEADING}
    headingKey="CTA.HEADING"
    subheadingKey="CTA.SUBHEADING"
  />
</Layout>
