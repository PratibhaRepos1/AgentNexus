---
interface Props {
  icon: string;
  title: string;
  description: string;
}
const { icon, title, description } = Astro.props;
const hasDetails = Astro.slots.has("details");
const hasFooter = Astro.slots.has("footer");
---

<div class="py-8">
  <div class="rounded-[2.5rem] bg-gradient-to-br from-violet-700 to-violet-200 p-6 shadow-sm shadow-violet-300 sm:p-10">
    <div class="grid items-stretch gap-8 lg:grid-cols-2 lg:gap-10">
      <div class="flex flex-col rounded-3xl bg-indigo-950 p-8">
        <h2 class="font-display text-3xl font-bold text-white sm:text-4xl">
          <span class="mr-2">{icon}</span>{title}
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-blue-100">{description}</p>
        {
          hasDetails && (
            <div class="mt-6 rounded-2xl bg-blue-50 p-5">
              <slot name="details" />
            </div>
          )
        }
        {hasFooter && <slot name="footer" />}
      </div>

      <div class="brand-gradient rounded-3xl p-8 shadow-sm shadow-violet-200">
        <div class="flex h-full min-h-[240px] items-center justify-center">
          <slot />
        </div>
      </div>
    </div>
  </div>
</div>
