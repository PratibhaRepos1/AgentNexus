---
const year = new Date().getFullYear();

const productLinks = [
  { href: "/features", label: "Features" },
  { href: "/pricing", label: "Pricing" },
  { href: "/demo", label: "Book a Free Demo" },
];
---

<footer class="border-t border-slate-100 bg-slate-50">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <a href="/" class="font-display text-xl font-bold tracking-tight">
          Chat<span class="brand-gradient-text">Biz</span>
        </a>
        <p class="mt-3 max-w-xs text-sm text-slate-500">
          A branded AI chat widget for small businesses — answers customer questions from your own FAQs,
          documents, and catalog, day or night.
        </p>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold text-slate-900">Product</h3>
        <ul class="mt-4 space-y-2">
          {
            productLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-slate-500 hover:text-violet-600">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3 class="font-display text-sm font-semibold text-slate-900">Get started</h3>
        <p class="mt-4 text-sm text-slate-500">
          Free plan available — no card required.
        </p>
        <a
          href="/demo"
          class="brand-gradient mt-4 inline-block rounded-full px-5 py-2.5 text-sm font-semibold text-white"
        >
          Book a Free Demo
        </a>
      </div>
    </div>

    <div class="mt-10 border-t border-slate-200 pt-6 text-sm text-slate-400">
      &copy; {year} ChatBiz. All rights reserved.
    </div>
  </div>
</footer>
