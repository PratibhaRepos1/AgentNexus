---
// Usage: <Price amount={49} /> instead of hardcoding "$49". Server-renders the real USD
// price (crawlable, no JS required for the common case); currencyStore.ts finds this node
// via [data-price-usd] and rewrites it instantly when the visitor's currency isn't USD.
import { BASE_CURRENCY } from "../config/currency";
import { formatCurrency } from "../utils/currencyFormatter";

interface Props {
  /** The price in USD — all product prices are authored in USD and converted from there. */
  amount: number;
}
const { amount } = Astro.props;
const isValid = Number.isFinite(amount);
if (!isValid) {
  console.warn(`[Price] Received a non-numeric amount (${JSON.stringify(amount)}) — check the caller's data source.`);
}
---

{isValid && <span data-price-usd={amount}>{formatCurrency(amount, BASE_CURRENCY)}</span>}
