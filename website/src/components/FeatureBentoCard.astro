---
interface Props {
  title: string;
  description: string;
  dot?: string;
  span?: string;
}
const { title, description, dot = "bg-violet-500", span = "lg:col-span-3" } = Astro.props;
---

<div class:list={["flex flex-col rounded-3xl border border-slate-300 bg-white p-6 sm:p-8", span]}>
  <div class="flex items-center gap-2.5">
    <span class:list={["h-2.5 w-2.5 rounded-full", dot]}></span>
    <h3 class="font-display text-2xl font-bold text-slate-900">{title}</h3>
  </div>
  <p class="mt-3 max-w-md text-lg text-slate-500">{description}</p>
  <slot />
</div>
