---
interface Props {
  line1: string;
  line2: string;
  subheading: string;
}
const { line1, line2, subheading } = Astro.props;
---

<section class="mx-auto max-w-6xl px-6 pt-12">
  <div class="brand-gradient relative overflow-hidden rounded-3xl px-8 py-16 text-center shadow-xl shadow-violet-200">
    <h1 class="font-display text-4xl font-extrabold leading-tight text-white sm:text-5xl">
      {line1} <br class="hidden sm:block" />
      {line2}
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-indigo-50">{subheading}</p>
    <slot name="extra" />
  </div>
</section>
