# Copy to .env and fill in your values. Never commit .env.

# Database
DATABASE_URL=postgresql://agentnexus:agentnexus@localhost:5432/agentnexus

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM providers — only set the keys for providers you use
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Optional paid providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# File upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Email Notification Send
RESEND_API_KEY=XYZ
# Resend free/unverified tier can only deliver to your own Resend account email
# using this sandbox address. Verify a domain at resend.com/domains and point
# this at an address on that domain to send to real recipients.
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev


# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Dashboard URL — used to build links in emails (e.g. password reset)
FRONTEND_URL=http://localhost:5173
